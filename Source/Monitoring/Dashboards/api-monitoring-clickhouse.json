                        "queryType": "table",
                        "rawSql": "-- SELECT\r\n--     $__timeInterval(timestamp + interval 3 hour + interval 30 minutes) AS time,\r\n--     count(*) / ($__interval_ms / 1000) AS rps\r\n-- FROM Monitoring.api_performance_logs\r\n-- WHERE $__timeFilter(timestamp + interval 3 hour + interval 30 minutes)\r\n-- GROUP BY time\r\n-- ORDER BY time\r\n-- WITH FILL\r\n--     FROM toStartOfInterval($__fromTime, INTERVAL 1 SECOND)\r\n--     TO toStartOfInterval($__toTime, INTERVAL 1 SECOND)\r\n--     STEP INTERVAL 1 SECOND\r\n\r\n\r\n\r\n\r\n\r\nSELECT\r\n    toStartOfInterval(\r\n        timestamp + interval 3 hour + interval 30 minutes,\r\n        INTERVAL $__interval_s SECOND\r\n    ) AS time,\r\n    count(*) / $__interval_s AS rps\r\nFROM Monitoring.api_performance_logs\r\nWHERE $__timeFilter(timestamp + interval 3 hour + interval 30 minutes)\r\nGROUP BY time\r\nORDER BY time\r\nWITH FILL\r\n    FROM toStartOfInterval(toDateTime($__from / 1000), INTERVAL $__interval_s SECOND)\r\n    TO toStartOfInterval(toDateTime($__to / 1000), INTERVAL $__interval_s SECOND)\r\n    STEP INTERVAL $__interval_s SECOND"
